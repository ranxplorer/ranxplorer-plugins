{
  "mcpServers": {
    "ranxplorer-mcp": {
      "type": "http",
      "url": "https://mcp.ranxplorer.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "cimd"
            },
            "authorizationUrl": "https://ranxplorer.com/oauth/authorize",
            "registrationUrl": "https://ranxplorer.com/oauth/register",
            "tokenUrl": "https://ranxplorer.com/oauth/token",
            "baseScopes": [
              "mcp:use"
            ]
          }
        }
      }
    }
  }
}
